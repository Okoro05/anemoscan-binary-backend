# Copy to .env for local use (the app reads real environment variables; on a host,
# set these in its dashboard instead).

DATABASE_URL=postgresql://user:password@host:5432/dbname
CORS_ORIGINS=https://your-web-app.example.com
MODEL_PATH=model/model.onnx
ADMIN_USERNAME=Admin26
ADMIN_PASSWORD=replace-with-the-admin-password
APP_ENV=production
